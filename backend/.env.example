# ============================================================
# 布谷 Cuckoo — 后端环境变量参考（.env.example）
# 复制为 backend/.env 并填写实际值。所有可转移参数集中在此，
# 完整说明见 docs/技术方案设计.md 的「配置与可转移参数」章节。
# ============================================================

# ---- 服务 ----
NODE_ENV=development
PORT=3000
# 服务模式：lan=局域网自用（CORS 放开任意来源）/ public=对外提供服务（CORS 走白名单 + 仅采信受信反代的 XFF 取真实 IP 限流）
# 两种模式都监听全部网卡——局域网设备直连与隧道/反代对外可并存。不设置时：生产=public，开发/测试=lan
SERVE_MODE=lan
# 允许跨域的前端来源，逗号分隔。仅 public 模式按此白名单校验；
# 对外服务时填公网域名（如 https://cuckoo.example.com）；App 内建来源 capacitor://localhost、https://localhost 已固定放行
CORS_ORIGINS=http://localhost:5173
# 额外受信的反向代理地址（逗号分隔），仅 public 模式用于判断是否采信 X-Forwarded-For。
# 留空 = 只信任回环地址（同机 cloudflared / nginx 已足够）；反代部署在另一台机器时填其 IP，
# 否则该反代写入的 XFF 不被采信，限流/登录防爆破会按反代自身 IP 计数（所有访客共用一个配额）
TRUSTED_PROXIES=
# 前端构建产物目录（可选，相对 backend 目录）。目录存在 index.html 时后端一并托管网页版，
# 一条对外 URL 即可同时提供网页与 API（同源无 CORS）；留空该值或目录不存在则仅提供 API。
FRONTEND_DIST=../frontend/dist

# ---- 数据库（SQLite）----
# 数据库文件路径，相对 backend 目录
DB_PATH=data/cuckoo.sqlite
# SQLite WAL 模式：true / false
DB_WAL=true

# ---- 认证 ----
# JWT 签名密钥。**生产环境必填**：缺失、仍是默认值或短于 32 字符时进程拒绝启动。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=please-change-me-in-production
# token 有效期（如 7d / 24h）
JWT_EXPIRES_IN=7d

# ---- 文件上传 ----
# 上传目录（相对 backend 目录；生产建议挂载独立磁盘，如 /var/lib/cuckoo/uploads）
UPLOAD_DIR=uploads
# multer 全局兜底上限（字节）。业务再按类型收窄：图片 10MB / 视频 60MB
MAX_FILE_SIZE=10485760

# ---- Web Push（需 VAPID 密钥对）----
# 生成密钥对：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cuckoo.example.com

# ---- 定时任务 ----
# 漏服扫描间隔（毫秒），默认 60000
MISSED_SCAN_INTERVAL_MS=60000
# 周报生成 cron，默认每周一 08:00
WEEKLY_REPORT_CRON=0 8 * * 1
# 月报生成 cron，默认每月 1 日 08:00
MONTHLY_REPORT_CRON=0 8 1 * *

# ---- 紧急联系人通知 ----
# 短信服务商：none / aliyun / twilio（当前仅实现站内通知，非 none 需自行接入）
SMS_PROVIDER=none

# ---- 种子数据 ----
# 是否灌入演示数据（演示账号 + 示例提醒）。**生产环境请设为 false**
SEED_DEMO_DATA=true

# ---- Android 安装包分发（可选）----
# 后端 /api/v1/app/download 提供的 APK 路径（绝对路径，或相对 backend 目录解析）。
# 留空 = 使用前端构建产物默认路径 ../frontend/android/app/build/outputs/apk/debug/app-debug.apk
#（重新打包 APK 后自动为最新）；该默认文件不存在时接口返回 404，/app/info 的 available=false
APP_APK_PATH=

# ---- 仅测试用（生产环境忽略）----
# 放宽登录/注册限流，仅当 NODE_ENV=test 时生效；用于 E2E 反复登录
# E2E_RATE_LIMIT=1000
