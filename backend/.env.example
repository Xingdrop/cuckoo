# ============================================================
# 甯冭胺 Cuckoo - 鍚庣鐜鍙橀噺鍙傝€冿紙.env.example锛?# 澶嶅埗涓?backend/.env 骞跺～鍐欏疄闄呭€笺€傛墍鏈夊彲杞Щ鍙傛暟闆嗕腑鍦ㄦ銆?# 瀹屾暣璇存槑瑙?docs/鎶€鏈柟妗堣璁?md 鐨勩€岄厤缃笌鍙浆绉诲弬鏁般€嶇珷鑺?# ============================================================

# ---- 鏈嶅姟 ----
NODE_ENV=development
PORT=3000
# 鍏佽璺ㄥ煙鐨勫墠绔潵婧愶紝閫楀彿鍒嗛殧
CORS_ORIGINS=http://localhost:5173

# ---- 鏁版嵁搴擄紙SQLite锛?---
# 鏁版嵁搴撴枃浠惰矾寰勶紝鐩稿 backend 鐩綍
DB_PATH=data/cuckoo.sqlite
# SQLite WAL 妯″紡: true / false
DB_WAL=true

# ---- 璁よ瘉 ----
# JWT 绛惧悕瀵嗛挜锛堢敓浜х幆澧冨繀椤绘浛鎹负寮洪殢鏈轰覆锛岀敓鎴? node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"锛?JWT_SECRET=please-change-me-in-production
# token 鏈夋晥鏈燂紝濡?7d / 24h
JWT_EXPIRES_IN=7d

# ---- 鏂囦欢涓婁紶 ----
# 涓婁紶鏂囦欢鏈湴瀛樺偍鐩綍锛堢敓浜у彲鎹?OSS/S3锛岃鏂囨。锛?UPLOAD_DIR=uploads
# 鍗曟枃浠跺ぇ灏忎笂闄愶紙瀛楄妭锛夛紝榛樿 10MB
MAX_FILE_SIZE=10485760  # 兜底上限（multer 100MB 固定）；业务按类型收紧：图片 10MB / 视频 60MB

# ---- Web Push锛圥WA 娴忚鍣ㄦ帹閫侊級----
# VAPID 鍏挜/绉侀挜锛岀敓鎴? npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cuckoo.example.com

# ---- 瀹氭椂浠诲姟锛園nestjs/schedule锛?---
# 婕忔湇鍒ゅ畾鎵弿闂撮殧锛堟绉掞級锛岄粯璁?1 鍒嗛挓
MISSED_SCAN_INTERVAL_MS=60000
# 鍛ㄦ姤鐢熸垚 cron锛岄粯璁ゆ瘡鍛ㄤ竴 08:00
WEEKLY_REPORT_CRON=0 8 * * 1
# 鏈堟姤鐢熸垚 cron锛岄粯璁ゆ瘡鏈?1 鏃?08:00
MONTHLY_REPORT_CRON=0 8 1 * *

# ---- 浜插弸閫氱煡 ----
# 鐭俊鏈嶅姟鍟嗭紙棰勭暀锛屽綋鍓嶄粎 APP 鍐呴€氱煡锛? none / aliyun / twilio
SMS_PROVIDER=none

# ---- 绉嶅瓙鏁版嵁 ----
# 鏄惁鍦ㄥ惎鍔ㄦ椂鍐欏叆绉嶅瓙鏁版嵁锛堝畼鏂硅鍒?寰繍鍔ㄥ簱/婕旂ず璐﹀彿锛?SEED_DEMO_DATA=true
