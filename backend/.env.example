# ============================================================
# 布谷 Cuckoo - 后端环境变量参考（.env.example）
# 复制为 backend/.env 并填写实际值。所有可转移参数集中在此。
# 完整说明见 docs/技术方案设计.md 的「配置与可转移参数」章节
# ============================================================

# ---- 服务 ----
NODE_ENV=development
PORT=3000
# 允许跨域的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173

# ---- 数据库（SQLite）----
# 数据库文件路径，相对 backend 目录
DB_PATH=data/cuckoo.sqlite
# SQLite WAL 模式: true / false
DB_WAL=true

# ---- 认证 ----
# JWT 签名密钥（生产环境必须替换为强随机串，生成: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"）
JWT_SECRET=please-change-me-in-production
# token 有效期，如 7d / 24h
JWT_EXPIRES_IN=7d

# ---- 文件上传 ----
# 上传文件本地存储目录（生产可换 OSS/S3，见文档）
UPLOAD_DIR=uploads
# 单文件大小上限（字节），默认 10MB
MAX_FILE_SIZE=10485760

# ---- Web Push（PWA 浏览器推送）----
# VAPID 公钥/私钥，生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@cuckoo.example.com

# ---- 方舟视觉 API（UI 评审工具 tools/ui_review.py 使用）----
ARK_API_KEY=ark-ec4ac84a-c8c4-47ad-aebc-2ec2afb02aae-ed77b
ARK_MODEL=doubao-seed-2-0-pro-260215

# ---- 定时任务（@nestjs/schedule）----
# 漏服判定扫描间隔（毫秒），默认 1 分钟
MISSED_SCAN_INTERVAL_MS=60000
# 周报生成 cron，默认每周一 08:00
WEEKLY_REPORT_CRON=0 8 * * 1
# 月报生成 cron，默认每月 1 日 08:00
MONTHLY_REPORT_CRON=0 8 1 * *

# ---- 亲友通知 ----
# 短信服务商（预留，当前仅 APP 内通知）: none / aliyun / twilio
SMS_PROVIDER=none

# ---- 种子数据 ----
# 是否在启动时写入种子数据（官方计划/微运动库/演示账号）
SEED_DEMO_DATA=true
